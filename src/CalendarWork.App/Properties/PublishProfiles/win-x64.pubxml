<?xml version="1.0" encoding="utf-8"?>
<!--
  배포용 게시 프로필: .NET 런타임 포함(self-contained), x64, ReadyToRun(콜드 스타트 단축).
  WPF는 Trimming을 지원하지 않으므로 끈다. 단일 파일(SingleFile)은 WPF 네이티브 DLL 문제로 쓰지 않는다.
  사용: dotnet publish src/CalendarWork.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>ko;en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
