<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!-- Dark 테마. 모든 브러시 Freeze (렌더링 비용·변경 감시 제거) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF1B1D22" po:Freeze="True" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFF2F2F2" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#FF9EA3AB" po:Freeze="True" />
    <SolidColorBrush x:Key="HolidayBrush" Color="#FFFF6B6B" po:Freeze="True" />
    <SolidColorBrush x:Key="SaturdayBrush" Color="#FF6BA8FF" po:Freeze="True" />
    <SolidColorBrush x:Key="TodayBrush" Color="#FFFFC107" po:Freeze="True" />
    <SolidColorBrush x:Key="TodayBackgroundBrush" Color="#2EFFC107" po:Freeze="True" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF26292F" po:Freeze="True" />
    <SolidColorBrush x:Key="LineBrush" Color="#33FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4F8DFF" po:Freeze="True" />
    <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="InputBrush" Color="#FF32363D" po:Freeze="True" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000" po:Freeze="True" />

    <!-- 메모 색상 4종: 기본 / 빨강 / 초록 / 파랑 -->
    <SolidColorBrush x:Key="MemoBrush0" Color="#FFE6E6E6" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoBrush1" Color="#FFFF8A80" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoBrush2" Color="#FF81C784" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoBrush3" Color="#FF64B5F6" po:Freeze="True" />
</ResourceDictionary>
