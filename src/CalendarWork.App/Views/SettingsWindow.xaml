<Window x:Class="CalendarWork.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CalendarWork.App.ViewModels"
        xmlns:behaviors="clr-namespace:CalendarWork.App.Views.Behaviors"
        mc:Ignorable="d"
        DataContext="{Binding Settings, Source={StaticResource Locator}}"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        behaviors:WindowBehaviors.CloseOnRequest="True"
        Title="CalendarWork 설정"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic"
        Background="{DynamicResource PanelBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,6,20,20">
        <TextBlock Text="모양" Style="{StaticResource Section}" />
        <DockPanel>
            <TextBlock Text="배경 불투명도" Width="100" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                       Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" />
            <Slider Minimum="0.1" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                    Value="{Binding BackgroundOpacity}" VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="테마" Width="100" />
            <RadioButton Content="다크" IsChecked="{Binding IsDarkTheme}" GroupName="Theme" />
            <RadioButton Content="라이트" IsChecked="{Binding IsLightTheme}" GroupName="Theme" />
        </StackPanel>
        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="음력 표시" Width="100" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding LunarDisplayOptions}" SelectedIndex="{Binding LunarDisplayIndex}" />
        </DockPanel>

        <TextBlock Text="바탕화면" Style="{StaticResource Section}" />
        <DockPanel>
            <TextBlock Text="부착 방식" Width="100" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding AttachModeOptions}" SelectedIndex="{Binding AttachModeIndex}" />
        </DockPanel>
        <TextBlock Margin="100,4,0,0" Style="{StaticResource SubtleText}" TextWrapping="Wrap"
                   Text="달력이 보이지 않거나 Wallpaper Engine 등과 겹치면 다른 방식을 선택하세요." />
        <CheckBox Content="Windows 시작 시 자동 실행" IsChecked="{Binding StartWithWindows}" Margin="0,10,0,0" />

        <TextBlock Text="단축키" Style="{StaticResource Section}" />
        <TextBlock Text="{Binding HotKeysText}" Style="{StaticResource SubtleText}" FontSize="12" LineHeight="20" />

        <TextBlock Text="공휴일 데이터" Style="{StaticResource Section}" />
        <TextBlock Text="원격 갱신 주소 (manifest.json이 있는 폴더, 비우면 내장 데이터만 사용)"
                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
        <TextBox Style="{StaticResource InputBox}" Margin="0,4,0,0"
                 Text="{Binding HolidayUpdateUrl, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Text="데이터" Style="{StaticResource Section}" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ToolButton}" Content="내보내기 (JSON)…" Command="{Binding ExportCommand}"
                    BorderBrush="{DynamicResource LineBrush}" />
            <Button Style="{StaticResource ToolButton}" Content="가져오기 (JSON)…" Command="{Binding ImportCommand}" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding DataFolderText}" Style="{StaticResource SubtleText}" Margin="0,6,0,0" TextWrapping="Wrap" />

        <!-- 하단: 버전·만든이 · 닫기 -->
        <DockPanel Margin="0,18,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="닫기"
                    IsCancel="True" Command="{Binding CloseCommand}" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource SubtleText}" />
                <TextBlock Text="{Binding AuthorText}" Style="{StaticResource SubtleText}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
